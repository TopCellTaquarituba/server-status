# Porta em que o servidor escuta (a maioria das hospedagens define automaticamente)
PORT=8787

# Chave secreta de publicação. Use a MESMA chave no app (Configurações > Acompanhamento do cliente).
# Gere uma chave longa e aleatória.
API_KEY=troque-esta-chave

# Onde guardar os status (opcional). Em hospedagens com disco efêmero, os dados
# podem ser recriados pelo app no próximo salvamento.
DATA_FILE=./data/status.json
